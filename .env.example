# Copy to .env for local runs (never commit the real .env).

# Canvas: Calendar page -> "Calendar Feed" link (bottom of the page).
CANVAS_ICS_URL=https://canvas.example.edu/feeds/calendars/xxxxxxxxxxxxxxxx.ics

# TimeEdit: the "Subscribe"/"Prenumerera" ICS URL, not a manual download.
TIMEEDIT_ICS_URL=https://cloud.timeedit.net/xxxxx/web/xxxx/xxxx.ics

# The dedicated Google Calendar to write into (Settings -> that calendar ->
# "Calendar ID"). Not tracked in config.yaml since it's personal, not a
# secret in the credential sense, but no reason to publish it either.
GOOGLE_CALENDAR_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@group.calendar.google.com

# Google Calendar auth is not an env var -- run `python -m src.auth_setup`
# once locally (see README) to produce token.json, which main.py reads by
# default. Only set this if you want it somewhere other than ./token.json.
# GOOGLE_TOKEN_FILE=token.json

# Only needed to run src/api.py (the calendar-normalizer API a Make.com
# scenario calls into -- see docs/make-scenario.md). Not used by src/main.py.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# and set the same value in both Render's env vars and the Make HTTP
# module's X-API-Key header.
API_KEY=
